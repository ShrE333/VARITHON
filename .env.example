# Copy to .env.local (or your panel's env file) and fill in.

# --- Database (server-only, never expose to the browser) ---
# Supabase → Settings → API. Only needed if you use server/store.supabase.ts;
# swap the store for Prisma/Drizzle/pg and these go away.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin write auth (server-only) ---
# Gates POST / PATCH / DELETE. If unset, writes are UNPROTECTED and the
# server logs a warning once per process. Fine locally, not fine deployed —
# DELETE is a real endpoint anyone could call.
#
#   openssl rand -hex 24
#
# Better: replace src/admin-locations/auth.ts with your panel's session
# check and ignore this entirely. See README §5.
ADMIN_API_TOKEN=
