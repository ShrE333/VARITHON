# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (public — safe to expose to the browser) ---
# Dashboard → Settings → API → Project URL / anon (or "publishable") key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ROUTE_SLUG=dnyaneshwar-2026

# --- Supabase (SECRET — server-only, never prefix with NEXT_PUBLIC_) ---
# Dashboard → Settings → API → service_role key.
# Used only by lib/palki/supabase-admin.ts to write Palki state/pings from
# the API routes. Without this, the app still runs (falls back to an
# in-process memory cache) but writes never persist to the database — fine
# for local dev, NOT fine for a real deploy (see DEPLOY.md).
SUPABASE_SERVICE_ROLE_KEY=

# --- Palki ingest auth (SECRET) ---
# Any random string. Required as a Bearer token on POST /api/v1/palki/ping
# so strangers can't fake the Palki's position. If unset, ingest is open —
# acceptable for local dev/demo, not for a public deploy.
PALKI_INGEST_TOKEN=
