# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
#
#   cp .env.example .env.local
#
# The app runs with NONE of these set: Supabase falls back to an in-process
# store and the route/facility data is served from public/data/*.json. That
# is enough for the full demo on a laptop. Everything below matters for a
# real deploy — see DEPLOY.md.

# ---------------------------------------------------------------------------
# Supabase — public. Safe to expose to the browser.
# Dashboard → Settings → API → Project URL / anon ("publishable") key.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Which pilgrimage route this deployment serves. Scopes every facility and
# Palki row. Leave as-is unless you have seeded another route.
NEXT_PUBLIC_ROUTE_SLUG=dnyaneshwar-2026

# ---------------------------------------------------------------------------
# Supabase — SECRET. Server-only; never prefix with NEXT_PUBLIC_.
# Dashboard → Settings → API → service_role key.
#
# Used by the API route handlers to write facilities and Palki state. Without
# it the app still runs, but writes never persist to the database — fine for
# local dev and the judge demo, NOT fine for a real deploy.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Palki ingest auth — SECRET.
# Any random string. Required as a Bearer token on POST /api/v1/palki/ping so
# strangers cannot fake the Palki's position. If unset, ingest is open —
# acceptable for local dev and the demo, not for a public deploy.
#
#   openssl rand -hex 24
# ---------------------------------------------------------------------------
PALKI_INGEST_TOKEN=

# ---------------------------------------------------------------------------
# Admin write auth — SECRET.
# Gates create/update/delete on /api/v1/admin/locations and the demo reset
# endpoint. If unset, those writes are UNPROTECTED and the server logs a
# warning once per process. Set it before deploying anywhere public.
#
#   openssl rand -hex 24
#
# See docs/ADMIN_LOCATIONS.md for swapping this for your panel's real auth.
# ---------------------------------------------------------------------------
ADMIN_API_TOKEN=
